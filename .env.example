# 飞书自建应用凭证
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# 默认自动化日报发送群 ID（oc_ 开头）
LARK_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 星图查询 API
XINGTU_API_BASE=https://autoxingtu.api.ali.trih.top
# 可选；当前查询接口无需鉴权，未来启用 Bearer 鉴权时可直接配置
XINGTU_API_TOKEN=

# 项目展示顺序；未列出的 project_id 会按数字升序自动追加
PROJECT_ORDER=3,1,2

# Web 管理页
PORT=3000
HOST=0.0.0.0

# 长连接卡片回调；在飞书开发者后台选择“使用长连接接收回调”，并订阅 card.action.trigger
LARK_LONG_CONNECTION_ENABLED=true

# 自动日报：Cron 为“分 时 日 月 周”，默认每天北京时间 09:00
AUTO_DAILY_REPORT_ENABLED=true
DAILY_REPORT_CRON=0 9 * * *
REPORT_TIMEZONE=Asia/Shanghai
