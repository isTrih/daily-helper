# 飞书自建应用凭证
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# 默认自动化日报发送群 ID（oc_ 开头）
LARK_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 星图查询 API
XINGTU_API_BASE=https://autoxingtu.api.ali.trih.top
# 必填；所有星图读取接口均使用该 JWT 作为 Bearer Token
INTERNAL_API_TOKEN=xxxxxxxxxxxxxxxx

# 项目展示顺序；未列出的 project_id 会按数字升序自动追加
PROJECT_ORDER=3,1,2
# 卡片主题色；格式为 project_id-color，多个项目以逗号分隔
COLOR=1-yellow,2-purple,3-blue,4-orange
# 标题图标；值为飞书上传图片后得到的 img_key
ICON=1-img_v2_xxxxxxxxxxxxxxx,2-img_v2_xxxxxxxxxxxxxxx

# Web 管理页
PORT=3000
HOST=0.0.0.0

# 长连接卡片回调；在飞书开发者后台选择“使用长连接接收回调”，并订阅 card.action.trigger
LARK_LONG_CONNECTION_ENABLED=true

# 自动日报：Cron 为“分 时 日 月 周”，默认每天北京时间 09:00
AUTO_DAILY_REPORT_ENABLED=true
DAILY_REPORT_CRON=0 9 * * *
REPORT_TIMEZONE=Asia/Shanghai
# 网页端每日推送计划的持久化文件；容器部署时请挂载 data 目录
SCHEDULES_FILE=data/schedules.json

# A2：有飞书应用凭证即可启用日报和插件上传；上传无需令牌
# 以下令牌仅用于手动采集、历史回填和管理状态接口，留空时这些管理接口不可访问
A2_UPLOAD_TOKEN=
A2_DATA_DIR=data/a2
A2_SCHEDULES_FILE=data/a2/report-schedules.json
A2_WIKI_TOKEN=V1vYwn6OxiayQlkajqWcSVLNnpc
CHROMIUM_PATH=/usr/bin/chromium
# 仅容器没有 Chromium sandbox 时需要；Dockerfile 已设置
CHROMIUM_NO_SANDBOX=false
